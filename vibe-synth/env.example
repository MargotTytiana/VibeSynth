# =============================================================================
# File: .env.example
# Purpose: Template for the .env file loaded by Pydantic-settings on startup.
#          Copy this file to .env and fill in the values for your environment.
#          Never commit .env to version control — it contains API keys.
#          All variables map directly to fields in backend/app/config.py.
# =============================================================================
#
# QUICK START
# -----------
# 1. cp .env.example .env
# 2. Set LLM_API_KEY (or set LLM_PROVIDER=local for offline use with Ollama)
# 3. cd backend && uvicorn app.main:app --reload
#
# =============================================================================


# ---------------------------------------------------------------------------
# LLM Provider
# ---------------------------------------------------------------------------
# Which LLM backend to use for Faust and shader code generation.
# Options: "openai" | "anthropic" | "local"
LLM_PROVIDER=openai

# The model identifier passed to the provider API.
# OpenAI examples   : gpt-4o, gpt-4o-mini, gpt-4-turbo
# Anthropic examples: claude-opus-4-6, claude-sonnet-4-6, claude-haiku-4-5-20251001
# Local examples    : llama3.1:8b, codellama:13b, mistral:7b (Ollama model names)
LLM_MODEL=gpt-4o

# API key for the selected provider.
# OpenAI    : https://platform.openai.com/api-keys
# Anthropic : https://console.anthropic.com/keys
# Local     : leave empty or set to any non-empty string (Ollama ignores it)
LLM_API_KEY=

# Maximum number of tokens the LLM is allowed to generate per request.
# Increase for complex multi-stage Faust programs; reduce to cut costs.
LLM_MAX_TOKENS=2048

# Sampling temperature (0.0 = deterministic, 1.0 = very creative).
# Keep low (0.1–0.3) for code generation to reduce syntax errors.
LLM_TEMPERATURE=0.2


# ---------------------------------------------------------------------------
# WASM Compilation Sandbox
# ---------------------------------------------------------------------------
# Maximum wall-clock time (ms) allowed for a single Faust-to-WASM compilation.
# Compilations that exceed this limit are aborted and trigger self-correction.
WASM_COMPILE_TIMEOUT_MS=5000

# Maximum loop iterations the shader sandbox enforces during static analysis.
# Shaders with for-loop bounds exceeding this value are rejected.
SANDBOX_MAX_LOOP_ITERATIONS=512


# ---------------------------------------------------------------------------
# Vector Cache
# ---------------------------------------------------------------------------
# Minimum cosine similarity for a cache lookup to count as a hit (0–1).
# Higher = stricter matching, fewer hits. Tune via experiments/prompt_ablation.ipynb.
# Default 0.92 performs well across a wide range of Vibe descriptions.
CACHE_SIMILARITY_THRESHOLD=0.92

# Maximum number of entries the in-process cache will hold before FIFO eviction.
CACHE_MAX_ENTRIES=1000

# Path to the JSON file where the cache index is persisted between restarts.
# Relative to the working directory (typically the project root).
CACHE_INDEX_PATH=cache/cache_index.json


# ---------------------------------------------------------------------------
# API Server
# ---------------------------------------------------------------------------
# Host and port for the Uvicorn ASGI server.
API_HOST=0.0.0.0
API_PORT=8000

# Set to true to enable auto-reload (development only — never use in production).
API_DEBUG=false

# Comma-separated list of origins allowed by the CORS middleware.
# The Vite dev server runs on port 5173 by default.
# In production, replace with your actual frontend domain.
API_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]


# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Log level for the root logger. Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Path to the CSV file where WASM compilation attempts are logged.
# Used by experiments/latency_benchmark analysis notebooks.
LOG_COMPILE_CSV=compiler/compile_log.csv
